+/* Embedding-owned buffers are charged to the runtime and GC budget. The
+   caller retains ownership on failure; the finalizer owns it on success. */
+typedef struct JSOwnedArrayBufferData {
+    size_t charged_bytes;
+    JSFreeArrayBufferDataFunc *free_func;
+    void *opaque;
+} JSOwnedArrayBufferData;
+
+static void js_owned_array_buffer_free(JSRuntime *rt, void *opaque, void *ptr)
+{
+    /* Detached/transferred source objects finalize again with a NULL data pointer. */
+    if (!ptr)
+        return;
+    JSOwnedArrayBufferData *data = opaque;
+    rt->malloc_ctx.malloc_state.malloc_size -= data->charged_bytes;
+    rt->malloc_ctx.malloc_state.malloc_count--;
+    /* Retain the learned automatic budget after a transient allocation.
+       Only cap it when it would consume the remaining hard-limit headroom;
+       leave half of that headroom available for subsequent JS allocations. */
+    const size_t live_bytes = rt->malloc_ctx.malloc_state.malloc_size;
+    const size_t limit = rt->malloc_ctx.malloc_state.malloc_limit;
+    const size_t headroom = limit > live_bytes ? limit - live_bytes : 0;
+    const size_t budget = live_bytes + (headroom >> 1);
+    if (!rt->malloc_gc_threshold_manual && rt->malloc_gc_threshold > budget)
+        rt->malloc_gc_threshold = budget;
+    data->free_func(rt, data->opaque, ptr);
+    js_free_rt(rt, data);
+}
+
+JSValue JS_NewArrayBufferOwned(JSContext *ctx, uint8_t *buf, size_t len,
+                              size_t charged_bytes,
+                              JSFreeArrayBufferDataFunc *free_func, void *opaque)
+{
+    JSRuntime *rt = ctx->rt;
+    JSMallocState *state = &rt->malloc_ctx.malloc_state;
+    JSOwnedArrayBufferData *data;
+    JSValue result;
+    const size_t previous_gc_threshold = rt->malloc_gc_threshold;
+    const BOOL previous_gc_manual = rt->malloc_gc_threshold_manual;
+    if (!buf || !free_func || len > INT32_MAX || charged_bytes < len)
+        return JS_ThrowRangeError(ctx, "invalid owned ArrayBuffer");
+    if (charged_bytes > SIZE_MAX - state->malloc_size)
+        return JS_ThrowOutOfMemory(ctx);
+    /* Include the incoming allocation when GC computes its next threshold.
+       Charging after GC can immediately trigger another full collection while
+       constructing the ArrayBuffer object. Roll back if adoption fails. */
+    state->malloc_size += charged_bytes;
+    state->malloc_count++;
+    js_trigger_gc(rt, 0);
+    if (state->malloc_size > state->malloc_limit) {
+        JS_ThrowOutOfMemory(ctx);
+        goto fail_charge;
+    }
+    data = js_malloc(ctx, sizeof(*data));
+    if (!data)
+        goto fail_charge;
+    data->charged_bytes = charged_bytes;
+    data->free_func = free_func;
+    data->opaque = opaque;
+    result = JS_NewArrayBuffer(ctx, buf, len, js_owned_array_buffer_free, data, FALSE);
+    if (JS_IsException(result)) {
+        js_free(ctx, data);
+        goto fail_charge;
+    }
+    return result;
+fail_charge:
+    state->malloc_size -= charged_bytes;
+    state->malloc_count--;
+    /* A rejected large buffer must not suppress later collections below the
+       unchanged hard memory limit. Preserve a lower threshold set by GC. */
+    if (rt->malloc_gc_threshold > previous_gc_threshold) {
+        rt->malloc_gc_threshold = previous_gc_threshold;
+        rt->malloc_gc_threshold_manual = previous_gc_manual;
+    }
+    return JS_EXCEPTION;
+}
+
 BOOL JS_IsArrayBuffer(JSValueConst obj)
 {
     return JS_GetClassID(obj) == JS_CLASS_ARRAY_BUFFER;
