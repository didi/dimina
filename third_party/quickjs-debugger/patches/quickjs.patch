+JSDebuggerLocation js_debugger_current_location(JSContext *ctx,
+                                                const uint8_t *cur_pc)
+{
+    JSDebuggerLocation location = { JS_ATOM_NULL, 0, 0 };
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    JSObject *p;
+    JSFunctionBytecode *b;
+    ptrdiff_t pc_offset;
+
+    if (!sf || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return location;
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (!p || !js_class_has_bytecode(p->class_id))
+        return location;
+    b = p->u.func.function_bytecode;
+    if (!b || !b->has_debug)
+        return location;
+
+    pc_offset = (cur_pc ? cur_pc : sf->cur_pc) - b->byte_code_buf - 1;
+    if (pc_offset < 0)
+        pc_offset = 0;
+    location.line = find_line_num(ctx, b, (uint32_t)pc_offset, &location.column);
+    location.filename = b->debug.filename;
+    return location;
+}
+
+JSDebuggerInfo *js_debugger_info(JSRuntime *rt)
+{
+    return &rt->debugger_info;
+}
+
+uint32_t js_debugger_stack_depth(JSContext *ctx)
+{
+    JSStackFrame *sf;
+    uint32_t depth = 0;
+
+    for (sf = ctx->rt->current_stack_frame; sf; sf = sf->prev_frame)
+        depth++;
+    return depth;
+}
+
+JSValue js_debugger_build_backtrace(JSContext *ctx, const uint8_t *cur_pc)
+{
+    JSStackFrame *sf;
+    JSValue frames = JS_NewArray(ctx);
+    uint32_t stack_index = 0;
+
+    for (sf = ctx->rt->current_stack_frame; sf; sf = sf->prev_frame) {
+        JSValue frame = JS_NewObject(ctx);
+        JSObject *p = NULL;
+        const char *name = get_prop_string(ctx, sf->cur_func, JS_ATOM_name);
+
+        JS_SetPropertyStr(ctx, frame, "id", JS_NewUint32(ctx, stack_index));
+        JS_SetPropertyStr(ctx, frame, "name",
+                          JS_NewString(ctx, name && name[0] ? name : "<anonymous>"));
+        JS_FreeCString(ctx, name);
+
+        if (JS_VALUE_GET_TAG(sf->cur_func) == JS_TAG_OBJECT)
+            p = JS_VALUE_GET_OBJ(sf->cur_func);
+        if (p && js_class_has_bytecode(p->class_id)) {
+            JSFunctionBytecode *b = p->u.func.function_bytecode;
+            if (b && b->has_debug) {
+                int column = 0;
+                int line;
+                const uint8_t *pc = (sf == ctx->rt->current_stack_frame && cur_pc)
+                    ? cur_pc
+                    : sf->cur_pc;
+                ptrdiff_t pc_offset = pc - b->byte_code_buf - 1;
+                if (pc_offset < 0)
+                    pc_offset = 0;
+                line = find_line_num(ctx, b, (uint32_t)pc_offset, &column);
+                JS_SetPropertyStr(ctx, frame, "filename",
+                                  JS_AtomToString(ctx, b->debug.filename));
+                if (line > 0) {
+                    JS_SetPropertyStr(ctx, frame, "line", JS_NewInt32(ctx, line));
+                    JS_SetPropertyStr(ctx, frame, "column", JS_NewInt32(ctx, column));
+                }
+            }
+        } else {
+            JS_SetPropertyStr(ctx, frame, "name", JS_NewString(ctx, "(native)"));
+        }
+        JS_SetPropertyUint32(ctx, frames, stack_index++, frame);
+    }
+    return frames;
+}
+
+int js_debugger_check_breakpoint(JSContext *ctx, uint32_t current_dirty,
+                                 const uint8_t *cur_pc)
+{
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    JSFunctionBytecode *b;
+    JSValue path_data = JS_UNDEFINED;
+    JSValue breakpoints = JS_UNDEFINED;
+    uint32_t breakpoint_count = 0;
+    ptrdiff_t pc_offset;
+    int hit = 0;
+
+    if (!sf || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return 0;
+    {
+        JSObject *f = JS_VALUE_GET_OBJ(sf->cur_func);
+        if (!f || !js_class_has_bytecode(f->class_id))
+            return 0;
+        b = f->u.func.function_bytecode;
+    }
+    if (!b || !b->has_debug || b->debug.filename == JS_ATOM_NULL)
+        return 0;
+
+    if (b->debugger.dirty != current_dirty) {
+        const char *filename;
+        JSValue length_value;
+
+        b->debugger.dirty = current_dirty;
+        filename = JS_AtomToCString(ctx, b->debug.filename);
+        if (!filename)
+            return 0;
+        path_data = js_debugger_file_breakpoints(ctx, filename);
+        JS_FreeCString(ctx, filename);
+        if (JS_IsUndefined(path_data))
+            goto done;
+
+        breakpoints = JS_GetPropertyStr(ctx, path_data, "breakpoints");
+        length_value = JS_GetPropertyStr(ctx, breakpoints, "length");
+        JS_ToUint32(ctx, &breakpoint_count, length_value);
+        JS_FreeValue(ctx, length_value);
+
+        if (!b->debugger.breakpoints)
+            b->debugger.breakpoints = js_mallocz_rt(ctx->rt, b->byte_code_len);
+        else
+            memset(b->debugger.breakpoints, 0, b->byte_code_len);
+        if (!b->debugger.breakpoints)
+            goto done;
+
+        for (uint32_t i = 0; i < breakpoint_count; i++) {
+            JSValue breakpoint = JS_GetPropertyUint32(ctx, breakpoints, i);
+            JSValue line_value = JS_GetPropertyStr(ctx, breakpoint, "line");
+            uint32_t breakpoint_line = 0;
+
+            JS_ToUint32(ctx, &breakpoint_line, line_value);
+            JS_FreeValue(ctx, line_value);
+            JS_FreeValue(ctx, breakpoint);
+            for (int pc = 0; pc < b->byte_code_len; pc++) {
+                int column = 0;
+                int line = find_line_num(ctx, b, (uint32_t)pc, &column);
+                if (line == (int)breakpoint_line) {
+                    b->debugger.breakpoints[pc] = 1;
+                    break;
+                }
+            }
+        }
+    }
+
+    if (!b->debugger.breakpoints)
+        goto done;
+    pc_offset = (cur_pc ? cur_pc : sf->cur_pc) - b->byte_code_buf - 1;
+    if (pc_offset >= 0 && pc_offset < b->byte_code_len)
+        hit = b->debugger.breakpoints[pc_offset];
+
+done:
+    JS_FreeValue(ctx, breakpoints);
+    JS_FreeValue(ctx, path_data);
+    return hit;
+}
+
+JSValue js_debugger_local_variables(JSContext *ctx, int stack_index)
+{
+    JSValue result = JS_NewObject(ctx);
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+
+    if (stack_index == 0 && JS_HasException(ctx))
+        JS_SetPropertyStr(ctx, result, "<exception>",
+                          JS_DupValue(ctx, ctx->rt->current_exception));
+    while (sf && stack_index-- > 0)
+        sf = sf->prev_frame;
+    if (!sf || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return result;
+
+    {
+        JSObject *f = JS_VALUE_GET_OBJ(sf->cur_func);
+        JSFunctionBytecode *b;
+        if (!f || !js_class_has_bytecode(f->class_id))
+            return result;
+        b = f->u.func.function_bytecode;
+        for (uint32_t i = 0; i < (uint32_t)(b->arg_count + b->var_count); i++) {
+            JSValue value = i < b->arg_count
+                ? sf->arg_buf[i]
+                : sf->var_buf[i - b->arg_count];
+            JSBytecodeVarDef *vd = &b->vardefs[i];
+            if (!JS_IsUninitialized(value))
+                JS_SetProperty(ctx, result, vd->var_name, JS_DupValue(ctx, value));
+        }
+    }
+    return result;
+}
+
+JSValue js_debugger_closure_variables(JSContext *ctx, int stack_index)
+{
+    JSValue result = JS_NewObject(ctx);
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+
+    while (sf && stack_index-- > 0)
+        sf = sf->prev_frame;
+    if (!sf || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return result;
+
+    {
+        JSObject *f = JS_VALUE_GET_OBJ(sf->cur_func);
+        JSFunctionBytecode *b;
+        if (!f || !js_class_has_bytecode(f->class_id))
+            return result;
+        b = f->u.func.function_bytecode;
+        for (uint32_t i = 0; i < b->closure_var_count; i++) {
+            JSVarRef *var_ref = f->u.func.var_refs ? f->u.func.var_refs[i] : NULL;
+            JSValue value;
+            if (!var_ref || !var_ref->pvalue)
+                continue;
+            value = *var_ref->pvalue;
+            if (!JS_IsUninitialized(value))
+                JS_SetProperty(ctx, result, b->closure_var[i].var_name,
+                               JS_DupValue(ctx, value));
+        }
+    }
+    return result;
+}
+
+JSValue js_debugger_evaluate(JSContext *ctx, int stack_index, JSValue expression)
+{
+    static const char helper_source[] =
+        "(function(__diminaScope, __diminaExpression) {"
+        "return (function() { with (__diminaScope) {"
+        "return eval(__diminaExpression);"
+        "} }).call(__diminaScope.this);"
+        "})";
+    JSValue scope = js_debugger_local_variables(ctx, stack_index);
+    JSValue closure = js_debugger_closure_variables(ctx, stack_index);
+    JSValue helper;
+    JSValue args[2];
+    JSValue result;
+
+    if (JS_SetPrototype(ctx, scope, closure) < 0) {
+        JS_FreeValue(ctx, closure);
+        JS_FreeValue(ctx, scope);
+        return JS_EXCEPTION;
+    }
+    JS_FreeValue(ctx, closure);
+    helper = JS_Eval(ctx, helper_source, sizeof(helper_source) - 1,
+                     "<debugger>", JS_EVAL_TYPE_GLOBAL);
+    if (JS_IsException(helper)) {
+        JS_FreeValue(ctx, scope);
+        return helper;
+    }
+    args[0] = scope;
+    args[1] = expression;
+    result = JS_Call(ctx, helper, JS_UNDEFINED, 2, args);
+    JS_FreeValue(ctx, helper);
+    JS_FreeValue(ctx, scope);
+    return result;
+}
