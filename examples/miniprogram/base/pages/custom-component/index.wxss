/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.lifecycle-test-card {
  box-sizing: border-box;
  width: 92%;
  margin: 24rpx auto;
  padding: 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 16rpx;
  background: #fff;
}

.lifecycle-test-title,
.lifecycle-test-description {
  display: block;
}

.lifecycle-test-title {
  color: #1f1f1f;
  font-size: 32rpx;
  font-weight: 600;
}

.lifecycle-test-description {
  margin-top: 12rpx;
  color: #666;
  font-size: 24rpx;
  line-height: 1.5;
}

.lifecycle-probe-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 20rpx 0;
}

.lifecycle-test-card button {
  display: block;
  margin: 12rpx 0 0;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
  width: 80%;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.usermotto {
  margin-top: 200px;
}

.avatar-wrapper {
  padding: 0;
  width: 56px !important;
  border-radius: 8px;
  margin-top: 40px;
  margin-bottom: 40px;
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

.nickname-wrapper {
  display: flex;
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  border-top: .5px solid rgba(0, 0, 0, 0.1);
  border-bottom: .5px solid rgba(0, 0, 0, 0.1);
  color: black;
}

.nickname-label {
  width: 105px;
}

.nickname-input {
  flex: 1;
}
