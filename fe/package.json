{
  "name": "dimina-fe",
  "description": "星河前端框架",
  "private": true,
  "author": "doslin",
  "packageManager": "pnpm@12.2.0",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=12.2.0"
  },
  "scripts": {
    "build:dev": "pnpm --filter container... build --mode development",
    "build": "pnpm --filter container... build --mode production",
    "compile": "node ./packages/compiler/src/bin/compile.js",
    "dev": "pnpm build:dev-deps && pnpm dev:services",
    "build:dev-deps": "pnpm --filter @dimina/fe-container-sdk^... build --mode development",
    "dev:services": "concurrently --kill-others \"node ./packages/server/index.js\" \"vite packages/container --mode development\"",
    "dev:native": "pnpm --filter container serve",
    "start:proxy": "node ./packages/server/index.js",
    "start:dev": "pnpm build:dev-deps && vite packages/container --mode development",
    "preview": "concurrently --kill-others-on-fail \"pnpm start:proxy\" \"pnpm preview:container\"",
    "preview:container": "pnpm --dir ./packages/container preview",
    "generate:sdk": "node ./scripts/generate-sdk.js",
    "generate:app": "node ./scripts/generate-app.js",
    "test": "pnpm --filter compiler --filter common --filter components --filter service --filter render --filter container --filter fe-container-sdk test && pnpm test:scripts",
    "test:scripts": "node --test scripts/generate-app.test.js scripts/dev.test.js",
    "coverage": "pnpm --filter compiler --filter common --filter components --filter service --filter render --filter container --filter fe-container-sdk coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "archiver": "^8.0.0",
    "concurrently": "^10.0.5",
    "fs-extra": "^11.4.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "volta": {
    "node": "22.22.3"
  }
}
