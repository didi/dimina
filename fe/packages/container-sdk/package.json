{
	"name": "@dimina/fe-container-sdk",
	"author": "doslin",
	"description": "Web 端小程序容器运行时 SDK",
	"type": "module",
	"engines": {
		"node": ">=22.22.3"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./style.css": "./dist/index.css",
		"./pageFrame": {
			"types": "./dist/pages/pageFrame/pageFrame.d.ts",
			"import": "./dist/pageFrame.js"
		},
		"./pageFrame.css": "./dist/pageFrame.css"
	},
	"scripts": {
		"test": "vitest run",
		"test:dev": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"build": "vite build",
		"postbuild": "tsc -p tsconfig.build.json",
		"dev": "concurrently --kill-others-on-fail \"vite build --watch\" \"tsc -p tsconfig.build.json --watch\""
	},
	"dependencies": {
		"mitt": "^3.0.1",
		"vconsole": "^3.15.1"
	},
	"devDependencies": {
		"@dimina/common": "workspace:^",
		"@dimina/components": "workspace:^",
		"@dimina/render": "workspace:^",
		"@dimina/service": "workspace:^",
		"@types/node": "^26.4.0",
		"sass": "^1.103.1",
		"typescript": "^5.9.3",
		"vite": "^8.2.2"
	}
}
