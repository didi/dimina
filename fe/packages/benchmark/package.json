{
  "name": "@dimina/benchmark",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "prepare:runtime": "pnpm --filter @dimina/fe-container-sdk... build --mode development",
    "compile:miniapp": "node ./scripts/compile-miniapp.mjs",
    "predev": "pnpm run prepare:runtime && pnpm run compile:miniapp",
    "dev": "vite --config ./vite.config.mjs",
    "bench": "node ./runner/run.js",
    "bench:baseline": "node ./runner/run.js --mode baseline",
    "compare": "node ./runner/compare.js"
  },
  "dependencies": {
    "@dimina/fe-container-sdk": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.3"
  }
}
