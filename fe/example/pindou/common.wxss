ex:1;flex:1;font-size:16px;font-weight:500;line-height:22px;color:#202426}.du-popup__title--center{text-align:center}.du-popup__close{position:absolute;top:16px;right:16px;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.du-empty{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.du-empty__img{width:180px;height:140px;margin-bottom:12px}.du-empty__text{font-size:14px;line-height:20px;color:#20242666}
