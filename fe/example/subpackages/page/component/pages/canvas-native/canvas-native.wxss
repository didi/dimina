.canvas-wrap {
  padding: 20rpx;
}

.canvas {
  width: 300px;
  height: 300px;
  background-color: #fff;
  border: 1px solid #ddd;
}

.btn-area {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}

.btn-area button {
  margin: 10rpx;
  font-size: 28rpx;
}

.log {
  padding: 20rpx;
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}
